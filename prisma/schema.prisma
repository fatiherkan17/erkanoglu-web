generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ProjectRequest {
  id       Int    @id @default(autoincrement())
  fullName String
  phone    String

  province     String
  district     String
  neighborhood String

  buildingType    String
  projectStage    String
  approximateArea String?
  interestAreas   String
  description     String?

  status         String    @default("YENI")
  source         String    @default("direct")
  priority       String    @default("NORMAL")
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project      Project?
  meetingNotes MeetingNote[]
}

model Project {
  id        Int     @id @default(autoincrement())
  projectNo String  @unique
  name      String?
  status    String  @default("AKTIF")

  published            Boolean @default(false)
  category             String  @default("KONUT")
  publicTitle          String?
  publicSummary        String?
  coverImageUrl        String?
  galleryImages        String?
  serviceLines         String?
  applicationProjects  String?
  workmanshipArchive   String?

  projectRequestId Int            @unique
  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Restrict)
  meetingNotes     MeetingNote[]
  quotes           Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeetingNote {
  id               Int      @id @default(autoincrement())
  projectId        Int?
  projectRequestId Int?
  type             String   @default("YUZ_YUZE")
  note             String
  meetingAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project        Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectRequest ProjectRequest? @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectRequestId])
  @@index([meetingAt])
}

model Quote {
  id             Int      @id @default(autoincrement())
  projectId      Int
  quoteNo        String   @unique
  quoteDate      DateTime @default(now())
  validUntil     DateTime?
  scope          String
  description    String?
  subtotal       Int
  vatRate        Int      @default(20)
  total          Int
  currency       String   @default("TRY")
  status         String   @default("TASLAK")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statusHistory QuoteStatusHistory[]

  @@index([projectId])
  @@index([quoteDate])
  @@index([status])
}

model QuoteStatusHistory {
  id         Int      @id @default(autoincrement())
  quoteId    Int
  fromStatus String?
  toStatus   String
  changedAt  DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([changedAt])
}
